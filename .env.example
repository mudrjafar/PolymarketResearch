# Copy to .env. Never share the real file.
POLYMARKET_RPC_URL=https://YOUR-QUICKNODE-ENDPOINT/
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN
# Optional: alerts work immediately to this chat. Otherwise send /start once.
TELEGRAM_CHAT_ID=

# Optional public CLOB override. Default: https://clob.polymarket.com
POLYMARKET_CLOB_URL=

# Paper settlement uses POLYMARKET_RPC_URL with the Polygon "finalized" tag first.
# Configure a trusted Heimdall-v2 endpoint only as the finality fallback.
POLYMARKET_HEIMDALL_URL=
